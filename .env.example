# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# @username публичного канала или числовой id (-100...)
TELEGRAM_CHANNEL_ID=@my_news_channel

# Необязательно:
# сколько разных источников должны написать о событии, чтобы оно считалось важным
MIN_SOURCES=5
# за какой период (часов) собирать новости для сравнения
WINDOW_HOURS=6
# не больше стольких постов за один запуск
MAX_POSTS=3
# как часто проверять новости (минут), в режиме docker / --loop
INTERVAL_MINUTES=30
# локальная модель для пересказа (Ollama). qwen2.5:3b ~2 ГБ, нужно ~4 ГБ RAM.
# Помощнее: qwen2.5:7b (~5 ГБ, ~8 ГБ RAM)
OLLAMA_MODEL=qwen2.5:3b
