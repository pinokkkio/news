# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# @username публичного канала или числовой id (-100...)
TELEGRAM_CHANNEL_ID=@my_news_channel
# Ключ API с https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Необязательно:
# минимальная важность 1–10 (выше — реже посты)
MIN_IMPORTANCE=7
NEWS_LANGUAGE=русский
CLAUDE_MODEL=claude-opus-5-5
