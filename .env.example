# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# @username публичного канала или числовой id (-100...)
TELEGRAM_CHANNEL_ID=@my_news_channel

# Необязательно:
# сколько разных источников должны написать о событии, чтобы оно считалось важным
MIN_SOURCES=5
# за какой период (часов) собирать новости для сравнения
WINDOW_HOURS=6
# не больше стольких постов за один запуск
MAX_POSTS=3
